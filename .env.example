# Copy to .env (no quotes around values). From Supabase Dashboard → Settings → API:
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Optional: force preview mode even when Supabase vars are set
# VITE_DEMO_MODE=true
# VITE_IGNORE_SUPABASE=true
# Auth → URL configuration: add http://localhost:8080 and your production URL
# Run all files in supabase/migrations/ on the project (SQL editor or supabase db push)
